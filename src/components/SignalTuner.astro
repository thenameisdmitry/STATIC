---
import { withBase } from '../lib/base';
// A receiver with a rotary knob you drag to tune. At 0% the screen shows a
// flickering NO SIGNAL frame; the scene image emerges from 3% to 98%;
// at lock (~98%) it swaps to the Operator frame with heavy glitching.
interface Props {
  receiver?: string;      // receiver image — CSS background of the device card
  screenNoSignal?: string; // NO SIGNAL frame, visible at 0%, gone by 5%
  screenIdle?: string;    // scene image, fades in from 3% to 98%
  screenLock?: string;    // Operator frame after lock
}
const { receiver: receiverRaw, screenNoSignal: nsRaw, screenIdle: idleRaw, screenLock: lockRaw } = Astro.props;
const receiver = withBase(receiverRaw);
const screenNoSignal = withBase(nsRaw);
const screenIdle = withBase(idleRaw);
const screenLock = withBase(lockRaw);

const screenVars = [
  screenNoSignal ? `--screen-nosignal: url('${screenNoSignal}')` : '',
  screenIdle ? `--screen-idle: url('${screenIdle}')` : '',
  screenLock ? `--screen-lock: url('${screenLock}')` : '',
].filter(Boolean).join('; ');
---
<div class="tuner" data-tuner data-locked="false">
  <div
    class="tuner__device"
    style={receiver ? `--receiver: url('${receiver}')` : undefined}
  >
    <button type="button" class="tuner__knob" aria-label="Tune the receiver">
      <span class="tuner__knob-mark"></span>
    </button>
    <div class="tuner__meter"><span class="tuner__meter-fill"></span></div>
    <div class="tuner__readout" data-readout>SIGNAL 0%</div>
  </div>

  <div class="tuner__screen" style={screenVars || undefined}>
    <div class="tuner__idle-swap"></div>
    <div class="tuner__nosignal"></div>
    <div class="tuner__glitch-ghost"></div>
    <div class="tuner__noise"></div>
    <div class="tuner__scanlines"></div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-tuner]').forEach((root) => {
    const knob = root.querySelector('.tuner__knob') as HTMLElement | null;
    const fill = root.querySelector('.tuner__meter-fill') as HTMLElement | null;
    const readout = root.querySelector('[data-readout]') as HTMLElement | null;
    if (!knob || !fill || !readout) return;

    let value = 0;
    let dragging = false;

    const apply = () => {
      (root as HTMLElement).style.setProperty('--signal', String(value));
      knob.style.transform = `rotate(${value * 270 - 135}deg)`;
      fill.style.width = `${Math.round(value * 100)}%`;
      readout.textContent = `SIGNAL ${Math.round(value * 100)}%`;
      root.setAttribute('data-locked', value > 0.97 ? 'true' : 'false');
    };

    const setFromPointer = (e: PointerEvent) => {
      const r = knob.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      const theta = (Math.atan2(e.clientY - cy, e.clientX - cx) * 180) / Math.PI;
      let t = theta - 135;
      if (t < 0) t += 360;
      if (t <= 270) value = t / 270;
      else value = t < 315 ? 1 : 0;
      apply();
    };

    knob.addEventListener('pointerdown', (e) => {
      dragging = true;
      knob.setPointerCapture(e.pointerId);
      setFromPointer(e);
    });
    knob.addEventListener('pointermove', (e) => { if (dragging) setFromPointer(e); });
    knob.addEventListener('pointerup', () => { dragging = false; });
    knob.addEventListener('pointercancel', () => { dragging = false; });

    apply();
  });
</script>