---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Redact from '../../components/Redact.astro';

const parts = [
  ['World bible', 'In-world classified documents. Use redaction reveals.'],
  ['Interactive dialogue', 'A short playable branching scene — your strongest sample.'],
  ['Character files', 'Cards, voice, barks.'],
  ['Collectibles', 'Tapes, case files, pages the player "finds".'],
  ['Screenplay scene', 'One scene in proper format.'],
  ['Design commentary', 'Why you made these narrative choices.'],
];
---
<BaseLayout title="STATIC — Vertical Slice">
  <section class="px-6 pt-16">
    <div class="mx-auto max-w-4xl">
      <p class="eyebrow mb-4">CH 02 · Featured project</p>
      <h1 class="signal-in font-display text-7xl font-semibold uppercase tracking-tight md:text-8xl">STATIC</h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-dim">
        Mystical-horror adventure in a small Alaskan town where something reaches through the
        <Redact label="the channel">television signal</Redact> and takes people. Fog. Tapes.
        Realities that won't hold still.
      </p>
      <p class="mt-3 font-mono text-xs text-ink-dim">[Draft logline from your brief — rewrite in your voice.]</p>

      <div class="mt-14 grid gap-4 md:grid-cols-2">
        {parts.map(([t, d], i) => (
          <div class="border border-line bg-raised p-6">
            <span class="font-mono text-xs text-violet">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="mt-2 font-display text-2xl uppercase tracking-tight text-ink">{t}</h2>
            <p class="mt-2 text-sm text-ink-dim">{d}</p>
            <p class="placeholder mt-3 inline-block text-xs">to build</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
