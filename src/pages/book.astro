---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="The Book — [Your Name]">
  <section class="px-6 pt-16">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow mb-4">CH 03</p>
      <h1 class="font-display text-6xl font-semibold uppercase tracking-tight md:text-7xl">The Book</h1>
      <p class="mt-6 text-lg text-ink-dim">[Title] — published [year]. <span class="placeholder inline-block">one-line description</span></p>

      <div class="mt-12 grid gap-8 md:grid-cols-[160px_1fr]">
        <div class="placeholder flex aspect-[2/3] items-center justify-center text-center">PLACEHOLDER<br />cover (2:3)</div>
        <div class="space-y-4 text-ink-dim">
          <p class="placeholder block">A strong translated excerpt — one scene/chapter, not the whole book.</p>
          <p class="placeholder block">2-3 illustrations.</p>
          <p class="placeholder block">Screen-adaptation pieces — the same material as a screenplay scene.</p>
          <p class="placeholder block">Your atmospheric AI videos as section breaks. [you have these]</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
