---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Signal — [Your Name]">
  <section class="px-6 pt-16">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow mb-4">CH 05</p>
      <h1 class="font-display text-6xl font-semibold uppercase tracking-tight md:text-7xl">Signal</h1>
      <p class="mt-6 text-lg text-ink-dim">Open the channel.</p>
      <ul class="mt-8 space-y-3 font-mono text-sm">
        <li><span class="text-violet">EMAIL</span> <a class="text-violet-bright hover:text-ink" href="mailto:you@example.com">you@example.com</a> <span class="placeholder inline-block text-xs">add</span></li>
        <li><span class="text-violet">CV</span> <a class="text-violet-bright hover:text-ink" href="/cv.pdf">Download (PDF)</a> <span class="placeholder inline-block text-xs">add file</span></li>
        <li><span class="text-violet">LINKEDIN</span> <span class="placeholder inline-block text-xs">add link</span></li>
        <li><span class="text-violet">SOCIAL</span> <span class="placeholder inline-block text-xs">Bluesky / X — add</span></li>
      </ul>
    </div>
  </section>
</BaseLayout>
