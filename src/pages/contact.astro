---
import BaseLayout from '../layouts/BaseLayout.astro';

const contacts = [
  { label: 'Email',     value: 'storiesbydz@gmail.com',        href: 'mailto:storiesbydz@gmail.com' },
  { label: 'Telegram',  value: '@moneywrapping',              href: 'https://t.me/moneywrapping' },
  { label: 'WhatsApp',  value: '+44 7442 896202',       href: 'https://wa.me/447442896202' },
  { label: 'Phone',     value: '+44 7442 896202',       href: 'tel:+447442896202' },
  { label: 'Residence', value: 'Belgrade, Serbia', href: null },
];
---
<BaseLayout title="Intercept My Signal — Dmitrii Zhukov">
  <section class="px-6 pt-16 pb-24">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow mb-4">CH 05</p>
      <h1 class="font-display text-5xl font-semibold uppercase tracking-tight md:text-6xl">
        Intercept My Signal
      </h1>
      <p class="mt-6 text-lg text-ink-dim">
        Use any of the channels below to reach me.
      </p>

      <ul class="contacts" data-signal-zone>
        {contacts.map(({ label, value, href }) => (
          <li class="contacts__row">
            <span class="contacts__label">{label}</span>
            {href
              ? <a class="contacts__value" href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener">{value}</a>
              : <span class="contacts__value contacts__value--plain">{value}</span>}
          </li>
        ))}
      </ul>

      <!-- signal meter -->
      <div class="sig" data-signal>
        <div class="sig__bars">
          {Array.from({ length: 32 }).map(() => <span class="sig__bar"></span>)}
        </div>
        <p class="sig__readout" data-signal-readout>NO CARRIER</p>
      </div>
    </div>
  </section>

  <script>
    const root = document.querySelector('[data-signal]');
    const zone = document.querySelector('[data-signal-zone]');
    if (root && zone) {
      const bars = Array.from(root.querySelectorAll('.sig__bar'));
      const readout = root.querySelector('[data-signal-readout]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      let target = 0;
      let strength = 0;

      document.addEventListener('pointermove', (e) => {
        const r = zone.getBoundingClientRect();
        const dx = Math.max(r.left - e.clientX, 0, e.clientX - r.right);
        const dy = Math.max(r.top - e.clientY, 0, e.clientY - r.bottom);
        const dist = Math.hypot(dx, dy);
        target = Math.max(0, 1 - dist / 340);
      }, { passive: true });

      const label = (s) =>
        s < 0.12 ? 'NO CARRIER'
        : s < 0.45 ? 'SIGNAL FAINT'
        : s < 0.8 ? 'LOCKING ON'
        : 'CHANNEL OPEN';

      const frame = (t) => {
        strength += (target - strength) * 0.1;
        root.style.setProperty('--sig', strength.toFixed(3));
        bars.forEach((b, i) => {
          const wobble = (Math.sin(t / 240 + i * 0.6) + 1) / 2;
          const noise = Math.random() * 0.35 + 0.65;
          b.style.height = `${4 + wobble * 5 + strength * wobble * noise * 48}px`;
        });
        readout.textContent = label(strength);
        requestAnimationFrame(frame);
      };

      if (reduce) {
        bars.forEach((b) => { b.style.height = '10px'; });
      } else {
        requestAnimationFrame(frame);
      }
    }
  </script>
</BaseLayout>