---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Fragments — [Your Name]">
  <section class="px-6 pt-16">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow mb-4">CH 04</p>
      <h1 class="font-display text-6xl font-semibold uppercase tracking-tight md:text-7xl">Fragments</h1>
      <p class="mt-6 text-lg text-ink-dim">Short experiments — proof you write constantly.</p>
      <div class="mt-10 space-y-4">
        <p class="placeholder block">A dozen character "barks".</p>
        <p class="placeholder block">A 200-word micro-story.</p>
        <p class="placeholder block">A drabble or two.</p>
      </div>
    </div>
  </section>
</BaseLayout>
