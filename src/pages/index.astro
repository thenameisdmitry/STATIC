---
import BaseLayout from '../layouts/BaseLayout.astro';
import Redact from '../components/Redact.astro';

const channels = [
  { href: '/writer', ch: '01', label: 'The Writer', blurb: 'Who I am, the career change, and why narrative.', featured: false },
  { href: '/game', ch: '02', label: 'STATIC', blurb: 'A vertical slice — lore, playable dialogue, case files, screenplay.', featured: true },
  { href: '/book', ch: '03', label: 'The Book', blurb: 'Excerpts, illustrations, and a screen adaptation.', featured: false },
  { href: '/lab', ch: '04', label: 'Fragments', blurb: 'Short experiments, barks, and micro-fiction.', featured: false },
  { href: '/contact', ch: '05', label: 'Signal', blurb: 'CV, email, and where to reach me.', featured: false },
];
---

<BaseLayout title="Dmitrii Zhukov — Writer">
  <!-- HERO -->
  <section class="relative px-6 pt-[11vh] pb-[11vh]">
    <div class="fog" aria-hidden="true">
      <div class="fog__layer fog__layer--a"></div>
      <div class="fog__layer fog__layer--b"></div>
      <div class="fog__layer fog__layer--c"></div>
    </div>
    <div class="relative z-10 mx-auto grid w-full max-w-6xl items-center gap-10 lg:grid-cols-[1fr_minmax(0,32rem)] lg:gap-10">        <!-- left: title -->
        <div>
          <p class="eyebrow mb-5">◉ Now broadcasting</p>
          <h1
            id="hero-title"
            class="signal-in font-display text-[19vw] font-semibold uppercase leading-[0.82] tracking-tight sm:text-[clamp(4rem,12vw,12rem)]"
          >
            STATIC
          </h1>
          <p class="mt-7 max-w-xl text-lg text-ink-dim">
            <span class="placeholder">Videogame concept created by Dmitrii Zhukov and 
              based on <Redact label="still in progress">the original novel <i>"Myst"</i>, </Redact> combining psychological thriller and survival 
              horror genres with immersive investigation mechanics, stealth gameplay, and 
              over-the-shoulder hand-to-hand combat.</span>
          </p>
          <p class="mt-8 font-mono text-xs uppercase tracking-widest text-ink-dim">↓ Tune in</p>
        </div>

        <!-- right: looping trailer (see ASSETS.md) -->
        <div class="trailer">
          <video class="trailer__video" autoplay muted loop playsinline preload="metadata" poster="/media/trailer-poster.jpg">
            <source src="/media/trailer.mp4" type="video/mp4" />
            <source src="/media/trailer.webm" type="video/webm" />
          </video>
          <div class="trailer__placeholder">
            <span class="font-mono text-xs uppercase tracking-widest text-violet-bright">◉ Trailer</span>
            <span class="font-mono text-[0.7rem] leading-relaxed">drop <b>trailer.mp4</b> into<br />/public/media/</span>
          </div>
        </div>
      </div>
    </section>

  <!-- INTRO STRIP -->
  <section class="px-6">
    <div class="mx-auto max-w-3xl border-y border-line py-12 text-center">
      <p class="text-xl leading-relaxed text-ink">
        I write characters, dialogue, and worlds — and I'm building a body of work toward
        narrative design in games. Some of what's behind these channels is
        <Redact label="still in progress">still finding its final form</Redact>,
        but it's all mine.
      </p>
      <p class="mt-4 font-mono text-xs text-ink-dim">[Replace with your own framing — short, in your voice.]</p>
    </div>
  </section>

  <!-- CHANNEL INDEX -->
  <section class="px-6 py-20">
    <div class="mx-auto max-w-6xl">
      <p class="eyebrow mb-8">Channel guide</p>
      <div class="grid gap-4 md:grid-cols-2">
        {
          channels.map((c) => (
            <a href={c.href} class={`channel ${c.featured ? 'channel--featured md:col-span-2' : ''} p-6 md:p-8`}>
              <div class="flex items-baseline justify-between">
                <span class="font-mono text-xs uppercase tracking-widest text-violet">CHANNEL {c.ch}</span>
                {c.featured && (
                  <span class="font-mono text-[0.65rem] uppercase tracking-widest text-magenta">◉ Featured project</span>
                )}
              </div>
              <h2 class="mt-3 font-display text-3xl font-semibold uppercase tracking-tight text-ink md:text-4xl">
                {c.label}
              </h2>
              <p class="mt-2 max-w-md text-ink-dim">{c.blurb}</p>
              <span class="mt-4 inline-block font-mono text-xs uppercase tracking-widest text-violet-bright">Open →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    // Ragged recurring static burst on the STATIC title.
    const title = document.getElementById('hero-title');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (title && !reduce) {
      const burst = () => {
        title.classList.add('glitch-active');
        window.setTimeout(() => title.classList.remove('glitch-active'), 460);
        window.setTimeout(burst, 2800 + Math.random() * 3600); // white noise timeframe
      };
      window.setTimeout(burst, 2600);
    }
  </script>

</BaseLayout>
